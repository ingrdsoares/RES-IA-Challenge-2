comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96527","corTextoConsulta":null,"textoConsulta":null},{"idAto":96492,"numeroAto":"1","anoAto":"2018","dataAto":"13/11/2018","dataPublicacao":"16/11/2018","tipoAto":{"nomeTipoAto":"Ordem de Serviço","siglaTipoAto":"OS","prioridadeTipoAto":29,"idTipoAto":56},"orgaos":[{"siglaOrgao":"ALF/AEG","nomeOrgao":"Alfândega da Receita Federal do Brasil no Aeroporto Internacional Eduardo Gomes","prioridadeOrgao":184,"idOrgao":465}],"ementa":"Revoga Ordem de Serviço nº 02/2003.","conteudo":null,"texto":null,"internet":"1","vigente":"1","resumoRevogado":null,"revigorado":"0","resumoRevigorado":null,"score":"0.00","prioridadeOrgao":"184","prioridadeTipoAto":"29","tipoSolucao":null,"comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96492","corTextoConsulta":null,"textoConsulta":null},{"idAto":96444,"numeroAto":"1","anoAto":"2018","dataAto":"12/11/2018","dataPublicacao":"14/11/2018","tipoAto":{"nomeTipoAto":"Ato Declaratório Executivo","siglaTipoAto":"ADE","prioridadeTipoAto":38,"idTipoAto":9},"orgaos":[{"siglaOrgao":"IRF/EPI","nomeOrgao":"Inspetoria da Receita Federal do Brasil em Epitaciolândia","prioridadeOrgao":189,"idOrgao":609}],"ementa":"Autoriza o Registro de Ajudante de Despachante Aduaneiro, conforme o § 3º do art. 810 do Dec. Nº 6.759, de 05 de fevereiro de 2009.","conteudo":null,"texto":null,"internet":"1","vigente":"1","resumoRevogado":null,"revigorado":"0","resumoRevigorado":null,"score":"0.00","prioridadeOrgao":"189","prioridadeTipoAto":"38","tipoSolucao":null,"comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96444","corTextoConsulta":null,"textoConsulta":null},{"idAto":96380,"numeroAto":"1","anoAto":"2018","dataAto":"06/11/2018","dataPublicacao":"12/11/2018","tipoAto":{"nomeTipoAto":"Portaria Conjunta","siglaTipoAto":"Port. Conj.","prioridadeTipoAto":24,"idTipoAto":81},"orgaos":[{"siglaOrgao":"PGFN","nomeOrgao":"Procuradoria-Geral da Fazenda Nacional","prioridadeOrgao":12,"idOrgao":222},{"siglaOrgao":"RFB","nomeOrgao":"Secretaria da Receita Federal do Brasil","prioridadeOrgao":63,"idOrgao":227}],"ementa":"Dispõe sobre o atendimento ao contribuinte relativo aos serviços da PGFN realizado nas unidades de atendimento da RFB.","conteudo":null,"texto":null,"internet":"1","vigente":"0","resumoRevogado":null,"revigorado":"0","resumoRevigorado":null,"score":"0.00","prioridadeOrgao":"12","prioridadeTipoAto":"24","tipoSolucao":null,"comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96380","corTextoConsulta":"rgb(237, 28, 36)","textoConsulta":"Revogado(a) pelo(a) Portaria Conjunta PGFN / RFB nº 1, de 3 de janeiro de 2025"},{"idAto":96347,"numeroAto":"1","anoAto":"2018","dataAto":"11/10/2018","dataPublicacao":"08/11/2018","tipoAto":{"nomeTipoAto":"Parecer Normativo","siglaTipoAto":"Parec. Norm.","prioridadeTipoAto":17,"idTipoAto":59},"orgaos":[{"siglaOrgao":"Cosit","nomeOrgao":"Coordenação-Geral de Tributação","prioridadeOrgao":124,"idOrgao":111}],"ementa":"<p>Assunto: Normas de Interpreta&ccedil;&atilde;o - Conceitos</p>\n\n<p>&nbsp;</p>\n\n<p>EXPORTA&Ccedil;&Atilde;O DE SERVI&Ccedil;OS &ndash; CONCEITO PARA FINS DE INTERPRETA&Ccedil;&Atilde;O DA LEGISLA&Ccedil;&Atilde;O TRIBUT&Aacute;RIA<br />\nConsidera-se exporta&ccedil;&atilde;o de servi&ccedil;os a opera&ccedil;&atilde;o realizada entre aquele que, enquanto prestador, atua a partir do mercado dom&eacute;stico, com seus meios dispon&iacute;veis em territ&oacute;rio nacional, para atender a uma demanda a ser satisfeita</p>\n\n<p>em um outro mercado, no exterior, em favor de um tomador que atua, enquanto tal, naquele outro mercado, ressalvada a exist&ecirc;ncia de defini&ccedil;&atilde;o legal distinta aplic&aacute;vel ao caso concreto e os casos em que a legisla&ccedil;&atilde;o dispuser em contr&aacute;rio.<br />\nLOCALIZA&Ccedil;&Atilde;O DO PRESTADOR &ndash; ATUA&Ccedil;&Atilde;O DO PRESTADOR DE SERVI&Ccedil;OS NO MERCADO DOM&Eacute;STICO<br />\nO prestador de servi&ccedil;os, enquanto tal, atua a partir do mercado dom&eacute;stico quando inicia a presta&ccedil;&atilde;o em territ&oacute;rio nacional por meio de atos preparat&oacute;rios</p>\n\n<p>anteriores &agrave; realiza&ccedil;&atilde;o material do servi&ccedil;o, relacionados com o planejamento, a identifica&ccedil;&atilde;o da expertise indispens&aacute;vel ou a mobiliza&ccedil;&atilde;o de recursos materiais e intelectuais necess&aacute;rios ao fornecimento.<br />\nLOCALIZA&Ccedil;&Atilde;O DO TOMADOR &ndash; ATUA&Ccedil;&Atilde;O DO TOMADOR NO MERCADO EXTERNO &ndash; DEMANDA POR SERVI&Ccedil;OS NO EXTERIOR<br />\nO tomador de servi&ccedil;os, enquanto tal, atua no mercado externo quando sua demanda pela presta&ccedil;&atilde;o ocorre no exterior, devendo ser satisfeita fora do territ&oacute;rio nacional.<br />\nLOCALIZA&Ccedil;&Atilde;O DA PRESTA&Ccedil;&Atilde;O &ndash; ATUA&Ccedil;&Atilde;O DO TOMADOR NO MERCADO EXTERNO &ndash; SERVI&Ccedil;OS EXECUTADOS EM BENS IM&Oacute;VEIS OU EM BENS M&Oacute;VEIS INCORPORADOS A BENS IM&Oacute;VEIS<br />\nSe o tomador de servi&ccedil;os, enquanto tal, atua no mercado externo e os servi&ccedil;os s&atilde;o executados em um im&oacute;vel ou em um bem incorporado a um im&oacute;vel, a demanda se considera atendida no territ&oacute;rio onde se situa o im&oacute;vel.<br />\nLOCALIZA&Ccedil;&Atilde;O DA PRESTA&Ccedil;&Atilde;O &ndash; ATUA&Ccedil;&Atilde;O DO TOMADOR NO MERCADO EXTERNO &ndash; SERVI&Ccedil;OS EXECUTADOS EM BENS M&Oacute;VEIS N&Atilde;O INCORPORADOS A BENS IM&Oacute;VEIS CUJA UTILIZA&Ccedil;&Atilde;O SE DAR&Aacute; APENAS NO EXTERIOR<br />\nSe o tomador de servi&ccedil;os, enquanto tal, atua no mercado externo e os servi&ccedil;os s&atilde;o executados em um bem m&oacute;vel n&atilde;o incorporado a um im&oacute;vel, uma vez demonstrado que aquele bem ser&aacute; utilizado apenas no exterior, a demanda se considera atendida no territ&oacute;rio ou nos territ&oacute;rios onde esse bem dever&aacute; ser utilizado.<br />\nLOCALIZA&Ccedil;&Atilde;O DA PRESTA&Ccedil;&Atilde;O &ndash; ATUA&Ccedil;&Atilde;O DO TOMADOR NO MERCADO EXTERNO &ndash; SERVI&Ccedil;OS EXECUTADOS EM BENS M&Oacute;VEIS SEM CONEX&Atilde;O COM DETERMINADO TERRIT&Oacute;RIO OU EXECUTADOS SEM REFERIMENTO A UM BEM F&Iacute;SICO<br />\nSe o tomador de servi&ccedil;os, enquanto tal, atua no mercado externo e os servi&ccedil;os s&atilde;o executados em um bem m&oacute;vel sem conex&atilde;o necess&aacute;ria com determinado territ&oacute;rio ou s&atilde;o executados sem referimento a qualquer bem f&iacute;sico, a demanda:<br />\na) quando uma parte relevante da presta&ccedil;&atilde;o deva se realizar necessariamente em determinado local com a presen&ccedil;a f&iacute;sica do prestador, se considera atendida naquele local;<br />\nb) quando, embora dispensada a presen&ccedil;a f&iacute;sica do prestador, for necess&aacute;ria sua presen&ccedil;a indireta (por subcontrata&ccedil;&atilde;o) ou virtual (pelo acesso compuls&oacute;rio a servi&ccedil;os eletr&ocirc;nicos locais sem os quais se tornaria obrigat&oacute;ria sua presen&ccedil;a f&iacute;sica direta ou indireta), se considera atendida onde sua presen&ccedil;a indireta ou virtual for indispens&aacute;vel; e<br />\nc) n&atilde;o havendo qualquer elemento de conex&atilde;o territorial relacionado com o resultado da presta&ccedil;&atilde;o, se considera atendida no local onde o tomador tem sua resid&ecirc;ncia ou domic&iacute;lio.<br />\nDISPOSITIVOS LEGAIS</p>\n\n<p>CF/88, art. 149, &sect; 2&ordm;, I, art. 153, V, art. 155, &sect; 2&ordm;, X, al&iacute;nea a e XII, al&iacute;neas e e f e art. 156, &sect; 3&ordm;, III; Lei n&ordm; 9.841, de 13 de agosto de 1997, art. 1&ordm;, inciso XI; Lei n&ordm; 10.406, de 10 de janeiro de 2002, art.&nbsp;79; Lei n&ordm; 10.637/02, art. 5&ordm;, II; Lei n&ordm; 10.833/03, art. 6&ordm;, II; MP 2.158-35/01, art. 14, III; Dec.&nbsp;n&ordm;&nbsp;6.306, de 14 de dezembro de 2007, art. 15-B.<br />\n<em>n&ordm; do e-processo 10030.000022/1207-02</em></p>\n","conteudo":null,"texto":null,"internet":"1","vigente":"1","resumoRevogado":null,"revigorado":"0","resumoRevigorado":null,"score":"0.00","prioridadeOrgao":"124","prioridadeTipoAto":"17","tipoSolucao":null,"comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96347","corTextoConsulta":null,"textoConsulta":null},{"idAto":96141,"numeroAto":"1","anoAto":"2018","dataAto":"29/10/2018","dataPublicacao":"30/10/2018","tipoAto":{"nomeTipoAto":"Ato Declaratório Executivo","siglaTipoAto":"ADE","prioridadeTipoAto":38,"idTipoAto":9},"orgaos":[{"siglaOrgao":"ALF/SLV","nomeOrgao":"Alfândega da Receita Federal do Brasil em Santana do Livramento","prioridadeOrgao":414,"idOrgao":592}],"ementa":"Inscrição no Registro de Ajudante de Despachante Aduaneiro.","conteudo":null,"texto":null,"internet":"1","vigente":"1","resumoRevogado":null,"revigorado":"0","resumoRevigorado":null,"score":"0.00","prioridadeOrgao":"414","prioridadeTipoAto":"38","tipoSolucao":null,"comportamento":null,"explanation":null,"urlVisualizacao":"https://normasinternet2.receita.fazenda.gov.br/#/consulta/externa/96141","corTextoConsulta":null,"textoConsulta":null},{"idAto":96015,"numeroAto":"1","anoAto":"2018","dataAto":"22/10/2018","dataPublicacao":"25/10/2018","tipoAto":{"nomeTipoAto":"Ato Declaratório Executivo","siglaTipoAto":"ADE","prioridadeTipoAto":38,"idTipoAto":9},"orgaos":[{"siglaOrgao":"DRF/MAC","nomeOrgao":"Delegacia da Receita Federal do Brasil em Maceió","prioridadeOrgao":241,"idOrgao":417}],"ementa":"&quot;Outorga aos peritos que menciona o credenciamento para a presta&ccedil;&atilde;o de servi&ccedil;o de per&iacute;cia para quantifica&ccedil;&atilde;o de mercadoria importada e a exportar.&quot