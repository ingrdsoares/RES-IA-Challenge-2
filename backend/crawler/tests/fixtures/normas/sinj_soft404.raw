    <body>
        <div id="div_norma">
            <!-- A epígrafe do texto da norma deverá ser um link que direciona, para uma nova aba, os detalhes daquela norma; tarefa 378-->
            
            <!-- corpo dela epigrafe-->

            <a href="/sinj/ ~/" title="Visitar o SINJ-DF - Sistema Integrado de Normas Jurídicas do
                DF"><img src="http://www.sinj.df.gov.br/sinjpadrao/Imagens/logo_sinj.png" alt="SINJ-DF" /></a>

            <div class="control">
                <div class="compilado">
                    <a href="javascript:void(0)" onclick="javascript:exibirAlteracoes(this);">
                        Texto Compilado
                    </a>
                </div>
                <div class="print">
                    <a href="javascript:void(0);" onclick="javascript:Print();" title="Imprimir">
                        <img alt="print" src="http://www.sinj.df.gov.br/sinjpadrao/Imagens/ico_print_p.png" />
                    </a>
                </div>
            </div>
            <div id="div_texto"></div>
