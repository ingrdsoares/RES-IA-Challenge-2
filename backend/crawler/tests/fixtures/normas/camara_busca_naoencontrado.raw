    <div class="container">
        <section id="topo-atas">
            <form action="" role="geral">
                <div class="form-search  mt-4 mb-4 row">
                    <div class="col-sm-12 col-lg-10 d-flex justify-content-center ">
                        <label for="busca"></label>
                        <input type="text" class="form-control" value="lei 99999 2003"id="geral" name="geral" placeholder="Digite aqui sua busca">
                    </div>
                    <div class="col-sm-12 col-lg-2 d-flex justify-content-center justify-content-md-end">
                        <button class="button campo-busca__botao">
                            <span class="btn__icon fas fa-search"></span>
                            <span class="btn__text">Buscar</span>
                        </button>
                    </div>
                </div>
            </form>
            <hr class="mb-4 separador-legislacao">
        </section>        <div class="row">
            <div class="l-busca__secao l-busca__secao--refine ">
                <aside id="refine-busca" class="refine-busca">
                    <div class="modal fade refine-busca__modal" tabindex="-1" role="dialog" aria-labelledby="refine-busca__titulo">
                        <div class="modal-dialog modal-dialog__full-screen refine-busca__modal-dialog" role="document">
                            <div class="modal-content js-modal-content refine-busca__modal-content">
                                <div class="modal-body refine-busca__modal-body">
                                    <div class="refine-busca__descricao">
                                        <h3 id="refine-busca__titulo" class="titulo-secao   refine-busca__titulo">
                                        
                                        
                                        
                                            <span class="titulo-secao__texto">Refine sua busca</span>
                                        
                                        
                                        
                                        </h3>                            <div class="js-refine-tags-filtros-conteiner" aria-live="polite">
                                        </div>
                                    </div>
            
                                    <div class="refine-busca__filtros" id="refine-busca__filtros" aria-live="polite">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>            <div class="l-busca__secao l-busca__secao--resultado ">
                <section class="navegacao-busca">
                    <button class="button filtro-mobile" type="button" data-toggle="modal" data-target=".refine-busca__modal">
                        <img src="https://www.camara.leg.br/legislacao/static/icon-filtro.png">
                        Opções de
                        filtragem
                    </button>
                    <div class="js-navegacao-tags-filtros-conteiner">
                        <ul class="tags" aria-label="Filtros aplicados">
            
                            <li class="tags__tag tags__tag--activated">
                                <span class="tags__text"><strong>Abrangência: </strong>Legislação Federal</span>
                                <a class="tags__remove"
                                    href="https://www.camara.leg.br/legislacao/busca?&ano=&tipo=&origem=&situacao=&geral=lei 99999 2003&numero=">
                                    <span aria-hidden="true">&times;</span>
                                </a>
                                <span class="sr-only">Remover filtro aplicado "Abrangência: Legislação Federal"</span>
                            </li>
            
            
            
            
            
                        </ul>
                    </div>
                </section>
            
                <section class="conteudo-busca">
                    <h2 class="sr-only">Resultados da Busca por Licitações</h2>
                    <div class="resultado-busca" aria-live="polite">
                        <div class="busca-info">
                            <div class="busca-info__resultado busca-info__resultado--informado">
                                <i>Exibindo resultados de 0 a 0 de 0</i>
                            </div>
                            <div class="busca-info__resultado busca-info__resultado--download">
                                <span class="linkImpressao">
                                    <spanclass="btn__icon fas fa-arrow-down "></span>
                                        <a target="_blank" href="https://www.camara.leg.br/legislacao/busca/exportar?&geral=lei 99999 2003&ano=&ordenacao=relevancia:DESC&abrangencia=Legislação Federal&tipo=&origem=&situacao=&numero=">
                                        <span class="resultados-info__link resultados-info__link--download" id="link-download"></span>Baixar (limitado a 300 documentos)</a></span>
                            </div>
                        </div>
                        <form action="" id="form-ordernacao" class="busca-info__ordenacao-form">
                            <div class="busca-info__ordenacao-item">
                                <input type="hidden" value="lei 99999 2003"
                                    name="geral" />
                                <input type="hidden" value="" name="ano" />
                                <input type="hidden" value=""
                                    name="situacao" />
                                <input type="hidden"
                                    value="Legislação Federal"
                                    name="abrangencia" />
                                <input type="hidden" value=""
                                    name="tipo" />
                                <input type="hidden" value=""
                                    name="origem" />
                                <input type="hidden" value=""
                                    name="numero" />
                                <label for="ordem-1" class="busca-info__etiqueta">Ordenar por: </label>
                                <select name="ordenacao" id="ordem-1" onchange="submitExec()">
                                    <option value="relevancia:DESC"  selected='selected'
                                        >mais relevantes</option>
                                    <option value="data:DESC" >mais recentes</option>
                                    <option value="data:ASC" >mais antigas</option>
                                </select>
                            </div>
                            <input class="d-none" type="submit" value="Ordenar">
                        </form>
                        <div class="busca-info__resultado--download-mobile">
                            <span class="linkImpressao">
                                    <a onclick="CriaPDF();" href="https://www.camara.leg.br/legislacao/busca/exportar?&geral=lei 99999 2003&ano=&ordenacao=relevancia:DESC&abrangencia=Legislação Federal&tipo=&origem=&situacao=&numero=">
                                        <span class="resultados-info__link resultados-info__link--download" id="link-download"></span>(limitado a 300 documentos)</a></span>
                        </div>
                        
                        <div id="impressaoPDF">
                            <ul class="busca-resultados">
                            </ul>
                        </div>
            
                    </div>
                    <nav class="pagination pagination--circular--up-xs" aria-label="Navegação entre páginas">
                        <ul class="pagination-list pagination-list--circular">
                            <li class="pagination-list__nav pagination-list__nav--prev disabled">
                                <a href="?&geral=lei 99999 2003&ano=&abrangencia=Legislação Federal&ordenacao=relevancia:DESC&tipo=&origem=&situacao=&numero=&pagina=0"
                                    class="pagination-list__nav-link" tabindex="-1">
                                    <span class="sr-only">Página </span>Anterior
            
                                </a>
                            </li>
            
            
