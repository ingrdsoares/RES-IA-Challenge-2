# Docker Compose reads backend/.env. Native API: export variables or use --env-file.
# Embeddings: serviço próprio do Compose (backend/embeddings), sem Ollama. O compose já
# aponta EMBEDDING_URL para http://embeddings:8080; deixe vazio só para voltar ao Ollama.
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Ollama: só para LLM_PROVIDER=ollama (geração local).
OLLAMA_URL=http://host.docker.internal:11434
GENERATION_MODEL=qwen3:8b
# Geração na nuvem: LLM_PROVIDER=google (ex.: GENERATION_MODEL=gemini-3.5-flash)
# ou deepseek (ex.: GENERATION_MODEL=deepseek-flash). Embeddings e reranker seguem locais.
LLM_PROVIDER=ollama
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Leitura de imagens já cadastradas na tela Fiscal pelo DeepSeek Flash.
GUIDE_VISION_ENABLED=false
# Gemini: nível de raciocínio enviado (vazio = padrão do modelo). Ex.: minimal no gemini-3.5-flash.
GOOGLE_REASONING_EFFORT=
COLLECTION_NAME=knowledge_base_v2
EMBEDDING_DIMENSIONS=1024
TOP_K=8
SCORE_THRESHOLD=0.5
QDRANT_TIMEOUT=5
OLLAMA_TIMEOUT=120
NUM_CTX=8192
NUM_PREDICT=1024
MAX_CONTEXT_CHARS=12000
RERANKER_URL=
RERANKER_TIMEOUT=10
# Ajustes de busca e pedido de dados (docs/avaliacao/melhorias-rag-rodada-2-2026-11-12.md)
CANDIDATE_K=30
LEGISLATION_BOOST=0.2
RERANK_LEGISLATION_BOOST=0
CONTEXT_WINDOW_CHARS=0
MAX_TRECHOS_POR_DOCUMENTO=0
ESCLARECIMENTO_MODELO=false
CONFERIR_CITACOES=false
PESO_EXPANSAO=0.5
# E-mails com acesso a GET /rag/metricas (separados por vírgula)
ADMIN_EMAILS=

# Autenticação local; produção requer HTTPS e COOKIE_SECURE=true.
POSTGRES_PASSWORD=sd_local
DATABASE_URL=postgresql+psycopg://postgres:sd_local@localhost:5432/socio_digital
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sd_local_user
S3_SECRET_KEY=sd_local_password

# Execução multiagente local (limites também aplicados no worker)
AGENT_TIMEOUT=120
AGENT_ROUND_SECONDS=600
AGENT_MAX_CALLS=30
AGENT_TOKEN_BUDGET=1228800
AGENT_MAX_CONFIRMATIONS=2
AGENT_STEP_ATTEMPTS=2

# Langfuse Prompt Management e traces
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
