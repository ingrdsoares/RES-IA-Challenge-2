# Docker Compose reads backend/.env. Native API: export variables or use --env-file.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
GENERATION_MODEL=qwen3:8b
COLLECTION_NAME=knowledge_base_v2
EMBEDDING_DIMENSIONS=1024
TOP_K=8
SCORE_THRESHOLD=0.5
QDRANT_TIMEOUT=5
OLLAMA_TIMEOUT=120
NUM_CTX=8192
NUM_PREDICT=1024
MAX_CONTEXT_CHARS=12000
RERANKER_URL=
RERANKER_TIMEOUT=10

# Autenticação local; produção requer HTTPS e COOKIE_SECURE=true.
POSTGRES_PASSWORD=sd_local
DATABASE_URL=postgresql+psycopg://postgres:sd_local@localhost:5432/socio_digital
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8000"]
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sd_local_user
S3_SECRET_KEY=sd_local_password
